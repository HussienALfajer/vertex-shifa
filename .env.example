# Local development settings. Copy to .env (git-ignored) and choose your own passwords; these
# values are fake. The repository is public: never commit a real .env.

# Local PostgreSQL 17 (packages/db). `pnpm db:setup-local` connects with the admin URL (a superuser
# of your local server) and creates the four roles with the passwords below and the database.
DATABASE_ADMIN_URL=postgres://postgres:fake-admin-password@localhost:5432/postgres
# Owner role: runs migrations (`pnpm db:migrate`) and creates the throwaway test databases.
DATABASE_OWNER_URL=postgres://shifa_owner:fake-owner-password@localhost:5432/vertex_shifa
# App role: what the apps connect as; row-level security always applies to it.
DATABASE_APP_URL=postgres://shifa_app:fake-app-password@localhost:5432/vertex_shifa
# Platform-jobs role: the worker's cross-tenant jobs (outbox dispatch); it cannot bypass RLS and
# every statement it runs is logged.
DATABASE_JOBS_URL=postgres://shifa_jobs:fake-jobs-password@localhost:5432/vertex_shifa
# Queue role: apps/worker runs pg-boss with it, in the pgboss schema only.
DATABASE_QUEUE_URL=postgres://shifa_queue:fake-queue-password@localhost:5432/vertex_shifa

# apps/api: it connects with DATABASE_APP_URL above and listens on the loopback address (ADR 0017).
API_HOST=127.0.0.1
API_PORT=3000
# apps/api identity (S02). All-zero development keys, fake on purpose: make your own with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# The keyed-hash key (OTP codes, refresh tokens, rate-limit keys), base64 of at least 32 bytes.
IDENTITY_HASH_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# The Ed25519 key that signs access tokens, device tokens and tickets (base64 PKCS #8 DER).
IDENTITY_TOKEN_KEY=MC4CAQAwBQYDK2VwBCIEIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Leading zero bits of the sign-in proof of work (default 18).
IDENTITY_POW_DIFFICULTY=18
# Only `fake` exists until S03: it sends nothing and prints "OTP for account <id>: <code>" to the
# API's output. The API refuses to start with it when NODE_ENV=production.
OTP_SENDER=fake
# The AES-256-GCM key of secrets the API reads back (console TOTP secrets), base64 of 32 bytes.
IDENTITY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# The console's origin: console writes from any other origin are refused. Production needs HTTPS.
CONSOLE_ORIGIN=http://localhost:5174

# apps/clinic does not read this file. Vite compiles VITE_API_URL into the renderer (`dev`, `build`)
# and the Electron main process reads it at start (`dev:electron`, `start`), so set it in the shell of
# each of those commands, for example `$env:VITE_API_URL = 'http://localhost:3000'` in PowerShell.
# Leave it unset for `pnpm build` before the clinic E2E, which answers the API on the app's origin.
# VITE_API_URL=http://localhost:3000

# apps/whatsapp-gateway: the WhatsApp transport. Only `fake` exists (sends nothing) until S03 adds
# Baileys.
WHATSAPP_TRANSPORT=fake
