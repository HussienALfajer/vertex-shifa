# Copy to .env (git-ignored). Synthetic values only in this file.
SESSION_NAME=test
CONTROL_PORT=7311
# Test recipients only: digits with country code, no "+", comma-separated. The gateway refuses every other number.
ALLOWED_RECIPIENTS=963900000001,963900000002
# Key for hashing OTP codes; any random string of 16+ characters.
OTP_PEPPER=replace-with-a-random-string
