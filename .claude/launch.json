{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vertex-shifa/api", "start"],
      "port": 3000
    },
    {
      "name": "clinic",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
