{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version"],
  "globalPassThroughEnv": ["CI", "NEXT_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL"
      ]
    },
    "@vertex-shifa/tokens#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/brand/**"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL"
      ]
    },
    "@vertex-shifa/ui#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/brand/**",
        "$TURBO_ROOT$/apps/clinic/src/**",
        "$TURBO_ROOT$/apps/console/src/**",
        "$TURBO_ROOT$/apps/site/src/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL"
      ]
    },
    "@vertex-shifa/clinic#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi.json"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL"
      ]
    },
    "@vertex-shifa/ui-native#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/patient/src/**"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    }
  }
}
